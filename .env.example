# Ceph S3 Load Testing Tool - Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=5000

# Default Ceph/S3 Endpoint
AWS_ENDPOINT_URL=http://your-ceph-endpoint:7480
AWS_REGION=default
AWS_ACCESS_KEY=your-access-key-here
AWS_SECRET_KEY=your-secret-key-here

# Test Configuration
DEFAULT_SCENARIO=mixed_7030
MAX_TIMESERIES_POINTS=3600
REQUEST_TIMEOUT=300

# Reports Configuration
REPORTS_DIR=reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=ceph_load_test.log

# UI Configuration (milliseconds)
METRICS_POLL_INTERVAL=1000

# Performance
MAX_CONCURRENT_OPS=256
